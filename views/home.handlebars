<p class="activitytitle">- ACTIVITY -</p>
{{#if user}}
{{#each activities}}
<div class="card activity">
	<section class="icon up">
		<i class="fa fa-map-marker"></o>
	</section>
	<section class="main">
		<span class="name">{{this.userid}}</span> visited <span class="name">this.name</span>
		<p class="subinfo">this.time</p>
	</section>
</div>
{{/each}}
{{else}}
<a href="/users/login">
<div class="card">
	<section class="icon">
		<i class="fa fa-frown-o"></i>
	</section>
	<section class="main">
		Login to see activity
	</section>
</div>
</a>
{{/if}}
<div class="floatbutton">
	<i class="fa fa-crosshairs"></i>
</div>