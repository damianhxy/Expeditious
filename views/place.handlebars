<div class="card name">
	<div class="img" style="background-image: url('https://maps.googleapis.com/maps/api/place/photo?key={{key}}&photoreference={{photos location.photos}}&maxwidth=400')"></div>
	{{#if user}}<div class="stamp {{visited user.visited location.name}}">{{visited user.visited location.name}}</div>{{/if}}
	<h1>{{location.name}}</h1>
	<p class="subinfo"><i class="fa fa-{{types location.types}}"></i> {{typename location.types}}</p>
	{{#if location.formatted_address}}
	<p class="subinfo"><i class="fa fa-map-marker"></i> {{location.formatted_address}}</p>
	{{/if}}
	{{#if location.hours}}
		<p class="subinfo"><i class="fa fa-clock-o"></i> {{location.hours}}</p>
	{{/if}}
	{{#if location.rating}}
	<p class="subinfo"><i class="fa fa-star"></i> Rating: {{location.rating}}</p>
	{{/if}}
</div>
{{#if location.website}}
<a href="{{location.website}}">
<div class="card">
	<section class="icon">
		<i class="fa fa-link"></i>
	</section>
	<section class="main">
		Visit Website
	</section>
</div>
</a>
{{/if}}
{{#if info}}
<div class="card info">
	<section class="icon up">
		<i class="fa fa-info-circle"></i>
	</section>
	<section class="main">
		<p class="content">{{info.text}}</p>
		<p class="source">{{info.source}}</p>
	</section>
</div>
{{/if}}
{{#if location.parking}}
<div class="card parking">
	<section class="icon">
		<i class="fa fa-car"></i>
	</section>
	<section class="main">
		<section class="left">
			<p>Parking Lots</p>
		</section>
		<section class="right">
			<p>{{location.parking}}</p>
		</section>
	</section>
</div>
{{/if}}
{{#if publictraveltime}}
<div class="card travel">
	<section class="icon">
		<i class="fa fa-clock-o"></i>
	</section>
	<section class="main">
		<section class="left">
			<p>Travel Time</p>
		</section>
		<section class="right">
			<p>{{publictraveltime}}</p>
		</section>
	</section>
</div>
{{/if}}